# =================================================================
# Student Skill & Placement Portal — Environment Variables Template
# Copy this file to .env or set environment variables in your deployment
# =================================================================

# -----------------------------------------------------------------
# Frontend Configuration (Vite React)
# -----------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8080/api

# -----------------------------------------------------------------
# Backend Server Configuration (Spring Boot)
# -----------------------------------------------------------------
SERVER_PORT=8080

# -----------------------------------------------------------------
# Supabase PostgreSQL Configuration
# -----------------------------------------------------------------
# Find these credentials in your Supabase Project Settings -> Database -> Connection string (JDBC)
# Example Supabase pooled connection string:
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
SPRING_DATASOURCE_URL=jdbc:postgresql://<your-supabase-db-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<your-project-ref>
SPRING_DATASOURCE_PASSWORD=your_supabase_database_password
SPRING_DATASOURCE_DRIVER=org.postgresql.Driver

# Note: If no Supabase credentials are provided, the backend automatically runs
# out-of-the-box using the embedded PostgreSQL-compatible H2 in-memory database with preloaded seed data!

# -----------------------------------------------------------------
# JWT Authentication Configuration
# -----------------------------------------------------------------
# Minimum 256-bit secret key for HMAC-SHA256 signing
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_EXPIRATION_MS=86400000
